# Network / routing
CONTROL_PLANE_HOST=pwa-preview.apps.example.com
PREVIEW_DOMAIN_SUFFIX=preview.example.com
PORT=3000
HOST=0.0.0.0

# Persistence
DATABASE_URL=postgres://pwa_preview:pwa_preview@postgres:5432/pwa_preview
DATA_ROOT=/data

# Session / OAuth - replace in every deployed environment
SESSION_SECRET=replace-with-at-least-32-random-characters
GITHUB_CLIENT_ID=replace-me
GITHUB_CLIENT_SECRET=replace-me

# Preview lifetime
TTL_MIN_MINUTES=5
TTL_DEFAULT_MINUTES=30
TTL_MAX_MINUTES=1440

# Artifact limits
MAX_COMPRESSED_BYTES=104857600
MAX_EXTRACTED_BYTES=524288000
MAX_FILE_COUNT=20000
MAX_PATH_LENGTH=1024

# URL artifact fetch
URL_FETCH_TIMEOUT_MS=30000
MAX_REDIRECTS=5

# Background maintenance
CLEANUP_INTERVAL_MS=60000
RECONCILIATION_INTERVAL_MS=600000
STALE_OPERATION_MINUTES=30
STALE_STAGING_MINUTES=60

# Database migrations
# For Coolify production, prefer false and run `npm run db:migrate` as a pre-deploy command.
MIGRATE_ON_START=true
